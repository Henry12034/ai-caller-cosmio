# Copia questo file in .env e riempi i valori. Il file .env non va mai condiviso né messo su GitHub.

# --- Chiavi dei servizi ---
OPENAI_API_KEY=            # versione 1 (platform.openai.com)
ELEVENLABS_API_KEY=        # versione 2 (elevenlabs.io, serve un piano a pagamento per le voci italiane e l'uso commerciale)

# --- Server ---
PORTA=5050
URL_PUBBLICO=              # indirizzo pubblico del server, es. https://receptionist.tuodominio.it
SEGRETO=                   # una stringa casuale lunga: protegge il webhook e il pannello
VERSIONE_ATTIVA=1          # 1 = la più veloce, 2 = la voce più realistica

# --- Twilio ---
TWILIO_NUMERO=             # il numero che risponde, es. +15551234567
# facoltativi: servono solo per gli SMS di conferma e per "Chiamami" dal pannello
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
CON_SMS=0                  # 1 = il receptionist manda l'SMS di conferma a fine prenotazione

# --- Il receptionist ---
NOME_RECEPTIONIST=Luca
GENERE_RECEPTIONIST=m      # m o f, per l'italiano ("sono pronto/pronta")

# --- Versione 1 (OpenAI Realtime) ---
V1_MODELLO=gpt-realtime
V1_VOCE=cedar
V1_VAD=server_vad
V1_SILENZIO_MS=350         # silenzio dopo cui risponde: meno = più veloce, ma rischia di partire nelle pause

# --- Versione 2 (ElevenLabs) ---
V2_VOCE=                   # voice_id di una voce italiana della libreria ElevenLabs
V2_LLM=claude-haiku-5-5
V2_RIEMPITIVO_S=1.8        # se tarda, dopo questi secondi dice "Mmh, allora..." (-1 = mai)
